pipeline {
    agent any
    environment {
        DOCKERHUB_CREDENTIALS = credentials('DockerHub')
        IMAGE_NAME = 'thekartik747/go-portfolio'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Run Tests & Lint') {
            steps {
                dir('go_portfolio/go-portfolio')
                {
                    sh 'go test -v ./...'
                }
                // sh 'go vet ./...'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('go_portfolio/go-portfolio')
                {
                    sh 'docker build -t $IMAGE_NAME:$BUILD_NUMBER -t $IMAGE_NAME:latest .'
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                script {
                    sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                    sh 'docker push $IMAGE_NAME:$BUILD_NUMBER'
                    sh 'docker push $IMAGE_NAME:latest'
                }
            }
        }

        stage('Deploy to Stage') {
            steps {
                sh '''
                    docker stop go-portfolio || true
                    docker rm go-portfolio || true
                    docker run -d --name go-portfolio -p 5000:5000 $IMAGE_NAME:$BUILD_NUMBER
                '''
            }
        }
    }

    post {
        success { echo 'Go Portfolio: Build, Test, and Deploy completed successfully!' }
        failure { echo 'Pipeline failed. Check logs.' }
    }
}
