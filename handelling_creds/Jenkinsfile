pipeline{
    agent any
    stages{
        stage('printing creds'){
            steps{
                withCredentials([usernamePassword(credentialsId: 'sampleCreds', passwordVariable: 'SamplePassword', usernameVariable: 'SampleUsername')]) {
                        echo 'hello world'
                        echo "Username = ${SampleUsername}"
                        // for using ${} use double quotes only
                        echo "Password = ${SamplePassword}"
                }
            }
        }
    }
}